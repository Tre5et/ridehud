{
  "schemaVersion": 1,
  "id": "ridehud",
  "version": "${version}",

  "name": "Ride Hud",
  "description": "Displays advanced information about ridden animals.",
  "authors": [
    "TreSet"
  ],
  "contact": {
    "homepage": "https://github.com/Tre5et/ridehud/releases",
    "sources": "https://github.com/Tre5et/ridehud",
    "issues": "https://github.com/Tre5et/ridehud/issues"
  },

  "license": "GPL-3.0",
  "icon": "assets/ridehud/icon.png",

  "environment": "*",
  "entrypoints": {
    "main": [
      "net.treset.ridehud.RideHudMod"
    ],
    "client": [
      "net.treset.ridehud.RideHudClient"
    ],
    "modmenu": [
      "net.treset.ridehud.modmenu.ModMenuCompat"
    ]
  },
  "mixins": [
      {
          "config": "ridehud.client.mixins.json",
          "environment": "client"
      }
  ],

  "depends": {
    "fabricloader": ">=0.14.20",
    "fabric-api": "*",
    "vanillaconfig": "~1.2.17-",
    "minecraft": ["~26.2-"],
    "java": ">=21"
  },
  "suggests": {
    "modmenu": "*"
  }
}
